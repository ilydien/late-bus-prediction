FROM python:3.12-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends libgomp1 \
  && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
  lightgbm \
  pandas \
  numpy \
  scikit-learn \
  psycopg2-binary \
  mlflow \
  boto3 \
  nats-py \
  coverage

COPY . /app

WORKDIR /app
