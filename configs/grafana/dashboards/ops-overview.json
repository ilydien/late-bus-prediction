{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "text": "DOWN" }, "1": { "color": "green", "text": "UP" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 16, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        { "expr": "wmata_service_up", "legendFormat": "{{service}}", "refId": "A" }
      ],
      "title": "Service Health Status (Monitor Probes)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        { "expr": "count(ALERTS{alertstate=\"firing\"}) OR vector(0)", "legendFormat": "Firing Alerts", "refId": "A" }
      ],
      "title": "Active Firing Alerts (vmalert)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 6 },
      "id": 3,
      "targets": [
        {
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name!=\"\"}[1m])) * 100",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "title": "Container CPU Usage (%)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 6 },
      "id": 4,
      "targets": [
        {
          "expr": "container_memory_working_set_bytes{name!=\"\"}",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "title": "Container Memory Working Set (Bytes)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 13 },
      "id": 5,
      "targets": [
        {
          "expr": "jetstream_consumer_num_pending",
          "legendFormat": "{{stream_name}}/{{consumer_name}}",
          "refId": "A"
        }
      ],
      "title": "NATS JetStream Consumer Pending (Lag)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 13 },
      "id": 6,
      "targets": [
        {
          "expr": "jetstream_stream_total_messages",
          "legendFormat": "{{stream_name}}",
          "refId": "A"
        }
      ],
      "title": "NATS JetStream Total Messages per Stream",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 20 },
      "id": 7,
      "targets": [
        {
          "expr": "pg_stat_activity_count",
          "legendFormat": "{{layer}}/{{datname}} ({{state}})",
          "refId": "A"
        }
      ],
      "title": "PostgreSQL Active Connections (Infra / Silver / Gold)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "text": "NOT REPLICATING" }, "1": { "color": "green", "text": "REPLICATING" } }, "type": "value" }
          ]
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 20 },
      "id": 8,
      "targets": [
        {
          "expr": "spock_subscription_is_replicating",
          "legendFormat": "{{layer}}/{{datname}}: {{subscription_name}}",
          "refId": "A"
        }
      ],
      "title": "Spock Bidirectional Replication Status",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 27 },
      "id": 9,
      "targets": [
        {
          "expr": "wmata_pipeline_job_runs_total",
          "legendFormat": "{{service}}/{{job}} ({{status}})",
          "refId": "A"
        }
      ],
      "title": "Pipeline Job Runs (Success vs Failed)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "VictoriaLogs" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 27 },
      "id": 10,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "level:ERROR OR level:WARNING",
          "refId": "A"
        }
      ],
      "title": "Recent Warning & Error Logs (VictoriaLogs)",
      "type": "logs"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": ["wmata", "ops", "monitoring"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "WMATA Platform — Ops Overview",
  "uid": "wmata-ops-overview",
  "version": 1
}
