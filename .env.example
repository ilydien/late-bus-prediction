# Host binding
HOST_IP=127.0.0.1

# PostgreSQL
# Silver and gold are two-node Spock clusters behind HAProxy. Clients must use
# the HAProxy host and the RW port; *_READ_PORT is used for read-only traffic.
POSTGRES_DB_INFRA=infra
POSTGRES_DB_WMATA=wmata
POSTGRES_DB_TRAFFIC=traffic

POSTGRES_INFRA_HOST=postgres-infra
POSTGRES_INFRA_USER=postgres
POSTGRES_INFRA_PASSWORD=postgres
POSTGRES_INFRA_PORT=5432
POSTGRES_INFRA_HOST_PORT=5432

POSTGRES_SILVER_HOST=haproxy
POSTGRES_SILVER_USER=postgres
POSTGRES_SILVER_PASSWORD=postgres
POSTGRES_SILVER_PORT=5433
POSTGRES_SILVER_READ_PORT=5435
POSTGRES_SILVER_HOST_PORT=5433

POSTGRES_GOLD_HOST=haproxy
POSTGRES_GOLD_USER=postgres
POSTGRES_GOLD_PASSWORD=postgres
POSTGRES_GOLD_PORT=5434
POSTGRES_GOLD_READ_PORT=5436
POSTGRES_GOLD_HOST_PORT=5434

# Spock replication role and image
PGEDGE_USER=pgedge
PGEDGE_PASSWORD=pgedge

# VictoriaMetrics
VM_RETENTION=3M

# VictoriaLogs
VL_RETENTION=3M

# SeaweedFS (S3-compatible object storage)
SEAWEEDFS_S3_ENDPOINT=http://seaweedfs:8333
SEAWEEDFS_ACCESS_KEY=seaweedfs-access-key
SEAWEEDFS_SECRET_KEY=seaweedfs-secret-key
SEAWEEDFS_BUCKET_WMATA_BRONZE=wmata
SEAWEEDFS_BUCKET_TRAFFIC_BRONZE=traffic
SEAWEEDFS_BUCKET_MLFLOW=mlflow
WMATA_KEY_ID=wmata-key-id
WMATA_SECRET_KEY=wmata-secret-key
TRAFFIC_KEY_ID=traffic-key-id
TRAFFIC_SECRET_KEY=traffic-secret-key
MLFLOW_KEY_ID=mlflow-key-id
MLFLOW_SECRET_KEY=mlflow-secret-key

# Telegram Alerts
TELEGRAM_BOT_API_KEY=
TELEGRAM_CHAT_ID=
