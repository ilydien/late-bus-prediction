# Host binding
HOST_IP=127.0.0.1

# PostgreSQL
POSTGRES_DB_INFRA=infra
POSTGRES_DB_WMATA=wmata
POSTGRES_DB_TRAFFIC=traffic

POSTGRES_INFRA_HOST=postgres-infra
POSTGRES_INFRA_USER=postgres
POSTGRES_INFRA_PASSWORD=postgres
POSTGRES_INFRA_PORT=5432
POSTGRES_INFRA_HOST_PORT=5432

POSTGRES_SILVER_HOST=postgres-silver
POSTGRES_SILVER_USER=postgres
POSTGRES_SILVER_PASSWORD=postgres
POSTGRES_SILVER_PORT=5433
POSTGRES_SILVER_HOST_PORT=5433

POSTGRES_GOLD_HOST=postgres-gold
POSTGRES_GOLD_USER=postgres
POSTGRES_GOLD_PASSWORD=postgres
POSTGRES_GOLD_PORT=5434
POSTGRES_GOLD_HOST_PORT=5434

# VictoriaMetrics
VM_RETENTION=3M

# VictoriaLogs
VL_RETENTION=3M

# Garage (S3-compatible object storage)
GARAGE_ADMIN_TOKEN=changeme
GARAGE_BUCKET_WMATA=wmata
GARAGE_BUCKET_TRAFFIC=traffic
WMATA_KEY_ID=wmata-key-id
WMATA_SECRET_KEY=wmata-secret-key
TRAFFIC_KEY_ID=traffic-key-id
TRAFFIC_SECRET_KEY=traffic-secret-key

# Telegram Alerts (optional)
TELEGRAM_BOT_API_KEY=
TELEGRAM_CHAT_ID=
